# Configuração do frontend.
# A chave precisa ter Maps JavaScript API + Places API (New) habilitadas
# e deve ser restringida por HTTP referrers no Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=

# Configuração do backend (Universal Server).
# Se não definido, o jogo usa a URL padrão hardcoded em src/lib/universalServer.ts.
VITE_UNIVERSAL_SERVER_URL=http://localhost:3000
VITE_UNIVERSAL_SERVER_API_KEY=
